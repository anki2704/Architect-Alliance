# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/architech-alliance
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/architech-alliance
MONGODB_URI=mongodb://127.0.0.1:27017/architech-alliance

# Long random string used to sign JWT auth tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# Server / deployment settings
PORT=3000
NODE_ENV=development
# Comma-separated browser origins allowed to call the API.
# Current Vercel frontend: https://architect-alliance.vercel.app
FRONTEND_URL=https://architect-alliance.vercel.app
# Set to 1 on Render/Hostinger when the app is behind their reverse proxy.
TRUST_PROXY=1

# Credentials used only by `npm run seed`. Never use demo/default passwords.
# The seed script now refuses to run if these are missing.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_DESIGNER_EMAIL=
SEED_DESIGNER_PASSWORD=
SEED_CUSTOMER_EMAIL=
SEED_CUSTOMER_PASSWORD=

# ---- Gmail OTP delivery (required for real OTP emails) ----
# 1. Use a Gmail account
# 2. Enable 2-Step Verification
# 3. Create an App Password: Google Account → Security → App passwords
# 4. Paste the 16-character app password below (not your normal Gmail password)
EMAIL_USER=your.gmail@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx
# Optional display name / from address
EMAIL_FROM=Architecture Alliance <your.gmail@gmail.com>
# Defaults are fine for Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465